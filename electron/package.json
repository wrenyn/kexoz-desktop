{
  "name": "kexoz",
  "productName": "Kexoz",
  "version": "1.4.5",
  "description": "Kexoz desktop - share your local apps, terminals and files securely",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "dev": "concurrently -k \"npm --prefix ../frontend run dev\" \"wait-on tcp:127.0.0.1:5173 && electron-forge start\"",
    "package": "npm --prefix ../frontend run build && electron-forge package",
    "make": "npm --prefix ../frontend run build && electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "test": "node --test src/fileServer.test.js",
    "e2e": "node scripts/e2e-shares.js"
  },
  "keywords": [],
  "author": {
    "name": "Wrenyn",
    "email": "jjagadesh980@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.4",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "concurrently": "^9.2.1",
    "css-loader": "^6.11.0",
    "electron": "41.1.1",
    "eslint": "^9.39.4",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "ws": "^8.21.3",
    "yamux-js": "^0.2.1"
  },
  "optionalDependencies": {
    "electron-installer-debian": "^3.2.0",
    "electron-installer-redhat": "^3.2.0"
  }
}
